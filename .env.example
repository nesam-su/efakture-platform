APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
APP_DATABASE_URL=postgresql+asyncpg://efakture:efakture@db:5432/efakture
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:8000
APP_ACCESS_TOKEN_MINUTES=30
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_WINDOW_SECONDS=900
APP_LOGIN_BLOCK_SECONDS=900
APP_PUBLIC_BASE_URL=https://efakture.example.rs
APP_PASSWORD_RESET_MINUTES=30
APP_SMTP_HOST=smtp.example.rs
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=true
APP_SMTP_FROM_EMAIL=noreply@efakture.example.rs
APP_ARTIFACT_STORAGE_PATH=/data/artifacts
APP_MAX_ARTIFACT_BYTES=26214400
APP_WORKER_POLL_SECONDS=2
APP_WORKER_LOCK_TIMEOUT_SECONDS=300
APP_SYNC_INTERVAL_SECONDS=60
APP_SYNC_INITIAL_LOOKBACK_DAYS=1
APP_SYNC_OVERLAP_SECONDS=60
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_DOMAIN=efakture.example.rs
